# InsightOps AI v0.4+ Configuration
# Copy this file to .env and add your actual API keys
# Do NOT commit .env to version control

# === Global LLM Settings ===
INSIGHTOPS_LLM_ENABLED=false
INSIGHTOPS_LLM_TIMEOUT_SECONDS=5
INSIGHTOPS_LLM_PROVIDER_ORDER=groq,huggingface,jetstream
# Deterministic offline provider used as the final fallback (works without keys).
INSIGHTOPS_LLM_MOCK_ENABLED=true

# === Adaptive Model Selection ===
INSIGHTOPS_FAST_MODEL=llama-3.1-8b-instant
INSIGHTOPS_STRONG_MODEL=llama-3.3-70b-versatile
INSIGHTOPS_STRONG_MODEL_MIN_TOKENS=12

# === Per-Provider Timeouts (seconds) ===
INSIGHTOPS_GROQ_TIMEOUT=4
INSIGHTOPS_HF_TIMEOUT=8
INSIGHTOPS_JETSTREAM_TIMEOUT=10

# === Resilience ===
INSIGHTOPS_CB_FAILURE_THRESHOLD=3
INSIGHTOPS_CB_COOLDOWN_SECONDS=60

# === API Limits & Caching ===
INSIGHTOPS_QUERY_MAX_LENGTH=500
INSIGHTOPS_QUERY_HISTORY_SIZE=100
INSIGHTOPS_DATA_CACHE_TTL_SECONDS=300
INSIGHTOPS_CORS_ORIGINS=*
INSIGHTOPS_LOG_LEVEL=INFO
# Emit single-line JSON logs for log aggregation (Loki/ELK/CloudWatch).
INSIGHTOPS_JSON_LOGS=false

# === Data Source ===
# INSIGHTOPS_SALES_DATA_PATH=./data/sales.csv

# === Groq Provider (Primary) ===
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# === Hugging Face Provider (Secondary) ===
# Get your API key from: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here
HF_API_URL=https://api-inference.huggingface.co/models
HF_MODEL=meta-llama/Llama-2-7b

# === Jetstream Provider (Tertiary Backup) ===
JETSTREAM_API_KEY=your_jetstream_api_key_here
JETSTREAM_API_URL=https://api.jetstream.ai/v1/chat/completions
JETSTREAM_MODEL=gpt-oss-120b
